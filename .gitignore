# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Generated results
# Versioned (small, part of the deliverable): results/metrics.csv,
# results/statistical_analysis.json, results/figures/, results/campaigns/
# (manifest + per-epoch histories).  Ignored (large or noisy):
results/predictions/*
!results/predictions/.gitkeep
results/*.log

# Checkpoints (large binary files)
checkpoints/*
!checkpoints/.gitkeep

# Processed data (generated from raw)
data/processed/*
!data/processed/.gitkeep

# Environment variables
.env
.env.local

# TensorFlow / Keras artifacts
*.h5
*.pb
saved_model/
